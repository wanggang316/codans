fastlane/screenshots/**/*.png
fastlane/test_output

*.profraw
.env
.DS_Store

# Per-machine secrets pulled into builds via xcconfig include. Template
# is tracked (Secrets.xcconfig.template); the live file holds the DSN.
apps/mac/Configurations/Secrets.xcconfig

# Per-machine performance baseline written by 0005 M8 tests (TC_PERF_BASELINE=capture).
# Each contributor and CI runner captures its own; not shared in the repo.
apps/mac/codans/Tests/Performance/baseline.json
apps/mac/codans/Tests/Performance/baseline.run.txt

apps/mac/.build/release/
apps/mac/.build/zmx/

# Agent tooling workspaces. `.claude/skills/` is the exception — those skills
# are project-specific knowledge that should follow the repo (e.g. release.skill
# carries the tip-channel cut flow). Everything else under `.claude/` (per-session
# AGENT_REGISTRY.md, settings.local.json, throwaway worktree state) stays local.
.claude/*
!.claude/skills/
.worktrees/

# harness-stack FDD per-plan runtime state (plans, contracts, validation, handoffs).
# Work-in-progress orchestration state, not a committed artifact — kept local by design.
.harness-runtime/
# Earlier runs leaked FDD validation/run artifacts (features.json, validation-state.json,
# evidence/repro/snapshot files) into docs/runs/. They belong in .harness-runtime/, not docs/.
docs/runs/
