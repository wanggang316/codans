---
import Base from "../layouts/Base.astro";
import BrewCommand from "../components/BrewCommand.astro";
import Download from "../components/Download.astro";
import Frames from "../components/Frames.astro";
import GitHubIcon from "../components/GitHubIcon.astro";
import GitLabIcon from "../components/GitLabIcon.astro";
import Shot from "../components/Shot.astro";
import { dictionary, type Locale } from "../i18n";
import { LINKS } from "../lib/links";
import { THEME_COLUMNS } from "../lib/themes";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<Base locale={locale} page="/" title={t.meta.title} description={t.meta.description}>
  <div class="wrap">
    <section class="pt-12 sm:pt-20">
      <h1 class="display max-w-[16em]" set:html={t.hero.title} />
      <p class="copy mt-6 max-w-[46em] text-[16px]">{t.hero.lede}</p>
      <div class="mt-8">
        <Download locale={locale} />
      </div>
      <p class="copy mt-3.5 text-[13px]">{t.hero.requirements}</p>
    </section>

  </div>

  <section class="tour" data-tour aria-label={t.hero.tabsLabel}>
    <div class="tour-views">
      {
        t.hero.views.map((view, index) => (
          <div
            class="tour-view"
            id={`tour-view-${index}`}
            role="tabpanel"
            aria-labelledby={`tour-tab-${index}`}
            data-active={index === 0 ? "" : undefined}
          >
            <Shot id={view.shot} alt={view.alt} eager={index === 0} class="tour-shot" />
          </div>
        ))
      }
    </div>
    <div class="tour-tabs" role="tablist" aria-label={t.hero.tabsLabel}>
      {
        t.hero.views.map((view, index) => (
          <button
            type="button"
            role="tab"
            class="tour-tab"
            id={`tour-tab-${index}`}
            aria-label={view.label}
            title={view.label}
            aria-controls={`tour-view-${index}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-view={index}
          />
        ))
      }
    </div>
  </section>

  <div class="wrap">
    <section class="section" id="agent-first">
      <header class="section-head">
        <p class="section-name">{t.agentFirst.name}</p>
        <h2 class="heading">{t.agentFirst.title}</h2>
        <p class="copy">{t.agentFirst.lede}</p>
      </header>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.agentFirst.cards.map((card) => (
            <article class="card">
              <Frames ids={card.shots} alt={card.alt} class="card-shot" />
              <h3 class="card-title" set:html={card.title} />
              <p class="copy card-body" set:html={card.body} />
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="parallel">
      <header class="section-head">
        <p class="section-name">{t.parallel.name}</p>
        <h2 class="heading">{t.parallel.title}</h2>
        <p class="copy">{t.parallel.lede}</p>
      </header>
      <div class="mt-10 grid gap-4 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="card card-flush">
          <Shot id="sidebar" alt={t.parallel.sidebarAlt} class="h-full max-h-[620px] object-cover object-top" />
        </div>
        <ul class="rows panel flex flex-col justify-center">
          {
            t.parallel.points.map((point) => (
              <li>
                <h3 class="subheading">{point.title}</h3>
                <p class="copy mt-2">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="pull-requests">
      <header class="section-head">
        <p class="section-name">{t.pr.name}</p>
        <h2 class="heading">{t.pr.title}</h2>
        <p class="copy prose-copy" set:html={t.pr.lede} />
      </header>
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          t.pr.platforms.map((platform) => (
            <article class="panel">
              <header class="flex items-center gap-3.5">
                {platform.id === "github" ? <GitHubIcon size={30} /> : <GitLabIcon size={30} />}
                <div>
                  <h3 class="subheading">{platform.name}</h3>
                  <p class="copy mt-0.5 text-[13px]" set:html={platform.via} />
                </div>
              </header>
              <ul class="checks copy mt-6">
                {platform.items.map((item) => (
                  <li data-unsupported={"unsupported" in item ? "" : undefined}>
                    <span>{item.text}</span>
                    {"unsupported" in item && <small>{item.unsupported}</small>}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="more">
      <header class="section-head">
        <p class="section-name">{t.more.name}</p>
        <h2 class="heading">{t.more.title}</h2>
      </header>

      <h3 class="group-title">{t.more.projects.title}</h3>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          t.more.projects.items.map((item) => (
            <article class="card">
              <Shot id={item.shot} alt={item.alt} class="card-shot card-shot-portrait" />
              <h4 class="card-title">{item.title}</h4>
              <p class="copy card-body">{item.body}</p>
            </article>
          ))
        }
      </div>

      <h3 class="group-title">{t.more.themes.title}</h3>
      <p class="copy max-w-[52em]">{t.more.themes.body}</p>
      <div class="themes">
        <div class="themes-plane">
          {
            THEME_COLUMNS.map((column) => (
              <ul class="themes-column">
                {[...column, ...column].map((item, index) => (
                  <li aria-hidden={index >= column.length ? "true" : undefined}>
                    <Shot
                      id={item.shot}
                      alt={index < column.length ? `${item.name} ${t.more.themes.altSuffix}` : ""}
                      class="rounded-md"
                    />
                    <p class="copy mt-2 text-[12.5px]">{item.name}</p>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>

      <h3 class="group-title">{t.more.speed.title}</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          t.more.speed.items.map((item) => (
            <article class="card">
              <Shot id={item.shot} alt={item.alt} class="card-shot" />
              <h4 class="card-title">{item.title}</h4>
              <p class="copy card-body" set:html={item.body} />
            </article>
          ))
        }
      </div>
    </section>

    <section class="inverse cta mt-24">
      <h2 class="display">{t.cta.title}</h2>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <Download locale={locale} />
        <a href={LINKS.repo} class="btn btn-quiet">
          <GitHubIcon size={17} />
          {t.cta.source}
        </a>
      </div>
      <div class="mt-4">
        <BrewCommand locale={locale} />
      </div>
      <p class="copy mt-4 text-[13px]">{t.hero.requirements}</p>
    </section>
  </div>
</Base>

<script>
  // Frames and recordings in a card play while the pointer is over the card. On a device
  // without hover they play while they are on screen.
  const canHover = window.matchMedia("(hover: hover)").matches;
  const whileActive = (target: Element, start: () => void, stop: () => void) => {
    if (canHover) {
      target.addEventListener("mouseenter", start);
      target.addEventListener("mouseleave", stop);
    } else {
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), {
        threshold: 0.7,
      }).observe(target);
    }
  };

  for (const frames of document.querySelectorAll<HTMLElement>("[data-frames]")) {
    const items = [...frames.querySelectorAll<HTMLElement>(".frame")];
    const dots = [...frames.querySelectorAll<HTMLElement>(".frames-dots i")];
    let current = 0;
    let timer: number | undefined;
    const show = (index: number) => {
      current = index % items.length;
      items.forEach((item, i) => item.toggleAttribute("data-active", i === current));
      dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === current));
    };
    whileActive(
      frames.closest(".card") ?? frames,
      () => {
        window.clearInterval(timer);
        show(1);
        timer = window.setInterval(() => show(current + 1), 3000);
      },
      () => {
        window.clearInterval(timer);
        show(0);
      },
    );
    // A click hands the frames to the reader: each click shows the next frame, and the
    // frames play by themselves again the next time the card becomes active.
    frames.addEventListener("click", () => {
      window.clearInterval(timer);
      show(current + 1);
    });
  }

  for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-hover-play]")) {
    whileActive(
      video.closest(".card") ?? video,
      () => void video.play().catch(() => {}),
      () => {
        video.pause();
        video.currentTime = 0;
      },
    );
  }

  // The tour advances by itself until the reader takes over.
  for (const tour of document.querySelectorAll<HTMLElement>("[data-tour]")) {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>("[data-view]")];
    const panels = [...tour.querySelectorAll<HTMLElement>(".tour-view")];
    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === current));
        tab.tabIndex = i === current ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.toggleAttribute("data-active", i === current));
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
      tour.removeAttribute("data-auto");
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        stop();
        show(i);
      });
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        stop();
        show(current + step);
        tabs[current].focus();
      });
    });
    // A click on the left half of a scene goes back; on the right half, forward.
    const views = tour.querySelector<HTMLElement>(".tour-views");
    views?.addEventListener("click", (event) => {
      const box = views.getBoundingClientRect();
      stop();
      show(current + (event.clientX < box.left + box.width / 2 ? -1 : 1));
    });
    tour.addEventListener("pointerdown", stop);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      tour.toggleAttribute("data-auto", true);
      timer = window.setInterval(() => show(current + 1), 6000);
    }
  }
</script>
