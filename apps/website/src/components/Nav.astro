---
import { Image } from "astro:assets";
import logo from "../assets/logo-256.png";
import GitHubIcon from "./GitHubIcon.astro";
import { dictionary, localePath, type Locale } from "../i18n";
import { LINKS } from "../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<header class="wrap">
  <nav class="flex h-16 items-center gap-4 text-[15px] whitespace-nowrap sm:gap-6" aria-label="Main">
    <a href={localePath(locale, "/")} class="mr-auto flex flex-none items-center gap-2.5 text-[17px] font-semibold">
      <Image src={logo} alt="" width={26} height={26} densities={[1, 2, 3]} class="rounded-md" />
      Codans
    </a>
    <a href={localePath(locale, "/changelog")} class="text-muted hover:text-ink">{t.nav.changelog}</a>
    <a href={LINKS.repo} class="nav-icon flex-none" aria-label={t.nav.github} title={t.nav.github}>
      <GitHubIcon size={18} />
    </a>
  </nav>
</header>
