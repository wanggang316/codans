---
import { Image } from "astro:assets";
import logo from "../assets/logo-256.png";
import { dictionary, localePath, otherLocale, type Locale } from "../i18n";
import { LINKS } from "../lib/links";

interface Props {
  locale: Locale;
  page: string;
}

const { locale, page } = Astro.props;
const t = dictionary(locale);
---

<header class="wrap">
  <nav class="flex h-16 items-center gap-5 text-[15px] sm:gap-7" aria-label="Main">
    <a href={localePath(locale, "/")} class="mr-auto flex items-center gap-2.5 text-[17px] font-semibold">
      <Image src={logo} alt="" width={26} height={26} densities={[1, 2, 3]} class="rounded-md" />
      Codans
    </a>
    <a href={localePath(locale, "/changelog")} class="text-muted hover:text-ink">{t.nav.changelog}</a>
    <div class="flex items-center gap-1">
      <a href={LINKS.repo} class="nav-icon" aria-label={t.nav.github} title={t.nav.github}>
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a
        href={localePath(otherLocale(locale), page)}
        hreflang={otherLocale(locale)}
        class="nav-icon"
        aria-label={t.nav.otherLocaleLabel}
        title={t.nav.otherLocaleLabel}
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 8 6 6" />
          <path d="m4 14 6-6 2-3" />
          <path d="M2 5h12" />
          <path d="M7 2h1" />
          <path d="m22 22-5-10-5 10" />
          <path d="M14 18h6" />
        </svg>
      </a>
    </div>
    <a href={LINKS.latestDmg} data-dmg download class="btn btn-primary btn-small">{t.nav.download}</a>
  </nav>
</header>
