---
import { Image } from "astro:assets";
import logo from "../assets/logo-256.png";
import { dictionary, localePath, otherLocale, type Locale } from "../i18n";
import { LINKS } from "../lib/links";

interface Props {
  locale: Locale;
  page: string;
}

const { locale, page } = Astro.props;
const t = dictionary(locale);
---

<header class="wrap">
  <nav class="flex h-16 items-center gap-5 text-[15px] sm:gap-7" aria-label="Main">
    <a href={localePath(locale, "/")} class="mr-auto flex items-center gap-2.5 text-[17px] font-semibold">
      <Image src={logo} alt="" width={26} height={26} densities={[1, 2, 3]} class="rounded-md" />
      Codans
    </a>
    <a href={localePath(locale, "/changelog")} class="text-muted hover:text-ink">{t.nav.changelog}</a>
    <a href={LINKS.repo} class="hidden text-muted hover:text-ink sm:inline">{t.nav.github}</a>
    <a
      href={localePath(otherLocale(locale), page)}
      hreflang={otherLocale(locale)}
      aria-label={t.nav.otherLocaleLabel}
      class="text-sm text-muted hover:text-ink"
    >
      {t.nav.otherLocale}
    </a>
    <a href={LINKS.latestDmg} data-dmg download class="btn btn-primary btn-small">{t.nav.download}</a>
  </nav>
</header>
