---
import GitHubIcon from "./GitHubIcon.astro";
import { dictionary, localePath, type Locale } from "../i18n";
import { LINKS } from "../lib/links";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<header class="site-header">
  <nav class="wrap flex h-16 items-center gap-4 text-[15px] whitespace-nowrap sm:gap-6" aria-label="Main">
    <a href={localePath(locale, "/")} class="brand mr-auto flex flex-none items-center gap-2.5 text-[17px] font-semibold" aria-label="Codans">
      <Logo />
      <span class="brand-name">Codans</span>
    </a>
    <a href={localePath(locale, "/changelog")} class="text-muted hover:text-ink">{t.nav.changelog}</a>
    <a href={LINKS.repo} class="nav-icon flex-none" aria-label={t.nav.github} title={t.nav.github}>
      <GitHubIcon size={18} />
    </a>
  </nav>
</header>

<script>
  // The header shows its bottom line when the page is not at the top.
  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 4);
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
