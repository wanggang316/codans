---
import { resolveShot } from "../lib/shots";

interface Props {
  /** Shot id: the file name stem under `public/shots/`. */
  id: string;
  alt: string;
  /** The first shot on the page loads eagerly; the others load lazily. */
  eager?: boolean;
  /** The layout width of the image, as a `sizes` value. The browser picks the file from it. */
  sizes?: string;
  class?: string;
}

// The default fits a card in the three-column grids.
const CARD = "(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw";

const { id, alt, eager = false, sizes = CARD, class: className = "" } = Astro.props;
const shot = resolveShot(id);
---

<img
  class:list={["shot", className]}
  src={shot.src}
  srcset={shot.srcset}
  sizes={shot.srcset ? sizes : undefined}
  width={shot.width}
  height={shot.height}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
