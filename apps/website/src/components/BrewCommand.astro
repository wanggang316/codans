---
import { dictionary, type Locale } from "../i18n";
import { LINKS } from "../lib/links";

interface Props {
  locale: Locale;
}

const t = dictionary(Astro.props.locale);
---

<div
  class="inline-flex h-11 max-w-full items-center gap-3 rounded-[10px] border border-line bg-surface pr-2 pl-3.5 font-mono text-sm text-ink"
>
  <span class="text-muted select-none" aria-hidden="true">$</span>
  <span class="truncate">{LINKS.brew}</span>
  <button
    type="button"
    class="group grid size-[30px] flex-none cursor-pointer place-items-center rounded-[7px] text-muted hover:bg-sunken hover:text-ink"
    aria-label={t.hero.copy}
    title={t.hero.copy}
    data-copy={LINKS.brew}
    data-copied={t.hero.copied}
  >
    <svg
      class="size-4 group-data-[done]:hidden"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
      <path d="M5.5 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v.5"></path>
    </svg>
    <svg
      class="hidden size-4 text-[#34c759] group-data-[done]:block"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m5 12.5 4.5 4.5L19 7.5"></path>
    </svg>
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const label = button.ariaLabel;
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      // The check mark shows while `data-done` is set.
      button.dataset.done = "";
      button.ariaLabel = button.title = button.dataset.copied!;
      setTimeout(() => {
        delete button.dataset.done;
        button.ariaLabel = button.title = label!;
      }, 1400);
    });
  }
</script>
