          "type": [
            "string",
            "null"
          ]
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeWorktree"
          }
        }
      },
      "required": [
        "id",
        "name",
        "rootPath",
        "worktrees"
      ],
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
