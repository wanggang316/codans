  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_ARGUMENT",
            "NOT_FOUND",
            "CONFLICT",
            "UNSUPPORTED",
            "OVERLOADED",
            "VERSION_MISMATCH",
            "APP_NOT_RUNNING",
            "REQUEST_TIMEOUT",
            "LAUNCH_TIMEOUT",
            "SOCKET_PERMISSION_DENIED",
            "SOCKET_UNUSABLE",
            "WRONG_CHANNEL",
            "INTERNAL",
            "NO_CURRENT_CONTEXT",
            "EMPTY_INPUT",
            "WAIT_TIMEOUT",
            "CAPTURE_UNSUPPORTED"
          ]
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "idMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "message"
      ],
      "additionalProperties": false
    },
    "treePane": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "workingDirectory": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "workingDirectory",
        "labels"
      ],
      "additionalProperties": false
    },
    "treeTab": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "handle": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "cachedDisplayTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treePane"
          }
        }
      },
      "required": [
        "id",
        "panes"
      ],
      "additionalProperties": false
    },
    "treeWorktree": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedTabID": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeTab"
          }
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "tabs"
      ],
      "additionalProperties": false
    },
    "treeProject": {
      "type": "object",
