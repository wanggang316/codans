{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codans.dev/schemas/cli-output.v1.json",
  "title": "codans CLI --json output",
  "description": "Every `codans <verb> --json` prints one object: `schemaVersion` (`codans.cli.<command path>.v1`, the same on every build channel) plus exactly one of `data` (success) or `error` (failure). Commands not bound below still use the envelope; their `data` is any object. `codans help-json` is the one exception and prints its tree bare. Nullable properties may be omitted entirely (the CLI omits nil fields).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^codans\\.cli\\.[a-z][a-z0-9.-]*\\.v1$"
    },
    "data": {
      "type": "object"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "data"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "data"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "codans.cli.tree.v1"
          }
        },
        "required": [
          "schemaVersion",
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/tree"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
