#!/bin/bash
# Flattens input archives to loose objects so the real libtool re-packs them
# aligned instead of dropping unaligned members (see ../activate.sh). Only
# the `-static -o <output> <inputs...>` form used by ghostty's LibtoolStep is
# rewritten; everything else goes to the real libtool.
set -euo pipefail

real=/usr/bin/libtool

if [ -z "${CODANS_LIBTOOL_FLATTEN:-}" ] || [ "${1:-}" != "-static" ] ||
  [ "${2:-}" != "-o" ] || [ "$#" -lt 4 ]; then
  exec "${real}" "$@"
fi

output="$3"
shift 3

work="$(mktemp -d "${TMPDIR:-/tmp}/libtool-flatten.XXXXXX")"
trap 'rm -rf "${work}"' EXIT

objects=()
index=0
for input in "$@"; do
  if [[ "${input}" != *.a ]]; then
    objects+=("${input}")
    continue
  fi

  index=$((index + 1))
  archive="$(cd "$(dirname "${input}")" && pwd)/$(basename "${input}")"
  members="$(/usr/bin/ar t "${archive}" | grep -v '^__\.SYMDEF' || true)"
  # `ar x` writes members to files named after them, so a repeated name
  # would silently overwrite an earlier object.
  duplicates="$(printf '%s\n' "${members}" | LC_ALL=C sort | uniq -d)"
  if [ -n "${duplicates}" ]; then
    echo "error: ${archive} repeats member names, cannot flatten it:" >&2
    printf '%s\n' "${duplicates}" | sed 's/^/  /' >&2
    exit 1
  fi

  dir="${work}/${index}"
  mkdir -p "${dir}"
  (cd "${dir}" && /usr/bin/ar x "${archive}")
  while IFS= read -r member; do
    [ -n "${member}" ] || continue
    chmod u+rw "${dir}/${member}"
    objects+=("${dir}/${member}")
  done <<< "${members}"
done

# Not exec: the EXIT trap must still remove the extracted objects.
"${real}" -static -o "${output}" "${objects[@]}"
